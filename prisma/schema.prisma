// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// PinUs 数据模型
// ============================================

/// 用户表
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String                    // bcrypt 哈希密码
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  ownedMaps    MapSpace[]  @relation("MapOwner")
  memberships  MapMember[]
  checkIns     CheckIn[]
  travelRoutes TravelRoute[]

  @@map("users")
}

/// 地图空间 —— 每个用户可以创建多个地图
model MapSpace {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  inviteCode  String   @unique @default(cuid()) // 邀请码
  isPublic    Boolean  @default(false)           // 是否公开可见
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关系
  ownerId  String       @map("owner_id")
  owner    User         @relation("MapOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  MapMember[]
  checkIns CheckIn[]
  travelRoutes TravelRoute[]

  @@map("map_spaces")
}

/// 地图成员关系
model MapMember {
  id   String @id @default(cuid())
  role String  @default("member") // owner | admin | member

  // 关系
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapSpaceId String    @map("map_space_id")
  mapSpace   MapSpace  @relation(fields: [mapSpaceId], references: [id], onDelete: Cascade)
  joinedAt   DateTime  @default(now())

  @@unique([userId, mapSpaceId])
  @@map("map_members")
}

/// 打卡记录 —— 核心功能
model CheckIn {
  id        String   @id @default(cuid())
  title     String
  content   String?  @db.Text
  latitude  Float    // 纬度
  longitude Float    // 经度
  address   String?  // 地址文字描述
  photos    String[] // 照片 URL 数组
  companions String? @db.Text // 同伴信息 JSON: [{userId?, name}]
  color     String?  @default("#3b82f6") // 钉子颜色（hex）
  visitedAt DateTime @default(now()) // 实际到访时间
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapSpaceId String    @map("map_space_id")
  mapSpace   MapSpace  @relation(fields: [mapSpaceId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

/// 旅游路线
model TravelRoute {
  id          String   @id @default(cuid())
  name        String
  description String?
  shareCode   String   @unique @default(cuid())
  color       String   @default("#8b5cf6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId     String @map("user_id")
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapSpaceId String @map("map_space_id")
  mapSpace   MapSpace @relation(fields: [mapSpaceId], references: [id], onDelete: Cascade)
  points     RoutePoint[]

  @@map("travel_routes")
}

/// 路线途经点（按 sortOrder 排序，首点为起点，末点为终点）
model RoutePoint {
  id        String  @id @default(cuid())
  label     String?
  latitude  Float
  longitude Float
  address   String?
  sortOrder Int     @map("sort_order")

  routeId String      @map("route_id")
  route   TravelRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("route_points")
}
