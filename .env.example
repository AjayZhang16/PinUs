# ============================================
# PinUs 环境变量配置
# ============================================

# 数据库连接 (PostgreSQL)
# 本地开发: postgresql://postgres:password@localhost:5432/pinus
# Supabase: 从 Supabase Dashboard → Settings → Database → Connection string 获取
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pinus"

# 高德地图 Key 和安全密钥
# 从 https://lbs.amap.com/ 注册获取
# 创建应用 → 添加 Key → 服务平台选 "Web端(JS API)"
NEXT_PUBLIC_AMAP_KEY="your_amap_key"
NEXT_PUBLIC_AMAP_SECURITY_KEY="your_amap_security_key"

# App 配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PinUs"

# JWT 密钥（生产环境请更换为随机长字符串）
JWT_SECRET="change-this-to-a-random-secret-in-production"

# Supabase 配置（照片上传）
# 从 Supabase Dashboard → Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
